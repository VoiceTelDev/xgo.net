	title: "Routing intelligence without the complexity.",
	text: "Get started with xGO LRN Lookup.",
	primary: { label: "Get API Access", href: "/contact/" },
	secondary: { label: "View Documentation", href: "/developers/" }
} %}
{%- include "partials/cta-card.njk" %}
